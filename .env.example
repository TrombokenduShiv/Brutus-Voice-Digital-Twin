GEMINI_API_KEY=
BVT_DEFAULT_TTS_PROVIDER=gemini
BVT_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
BVT_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
BVT_PROFILE_KEY=
BVT_PROFILE_ROOT=artifacts/voices
BVT_REQUIRE_CONSENT=true

# Choose one for non-native provider conversion.
BVT_TWIN_CONVERTER_CHECKPOINT=
BVT_TWIN_CONVERTER_URL=
BVT_CONVERTER_DEVICE=cuda
BVT_BIGVGAN_MODEL=nvidia/bigvgan_v2_24khz_100band_256x
BVT_BIGVGAN_CUDA_KERNEL=false
